# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Add one USERNAME/PASSWORD pair per scripted-login auth profile you define
# in docsolace.config.yaml (see its "auth" comments), matching the profile's
# usernameEnv/passwordEnv fields. Example:
#
# DOCSOLACE_STANDARD_USER_USERNAME=demo
# DOCSOLACE_STANDARD_USER_PASSWORD=demo-pass

# ── pcapvis team server (docker compose) ─────────────────────────────────────
POSTGRES_PASSWORD=change-me-long-random
PCAPVIS_ADMIN_USERNAME=admin
# First start only: creates this admin if no admin exists. Remove afterwards.
PCAPVIS_ADMIN_PASSWORD=change-me-at-least-10-chars
# Host port to publish the app on
PCAPVIS_PUBLISH_PORT=8080
# Set true when served behind HTTPS
PCAPVIS_COOKIE_SECURE=false
